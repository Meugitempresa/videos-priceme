# Copie para .env e preencha. NUNCA envie o .env para o git.

# Domínios (crie registros DNS do tipo A apontando para o IP da VPS)
DOMINIO_TYPEBOT=typebot.pharmaonlinedigital.com
DOMINIO_VIEWER=bot.pharmaonlinedigital.com
DOMINIO_ARQUIVOS=arquivos.pharmaonlinedigital.com

# Senhas e chaves (gere valores longos e aleatórios: openssl rand -hex 16)
POSTGRES_PASSWORD=troque-esta-senha
MINIO_USUARIO=pharmaminio
MINIO_SENHA=troque-esta-senha-tambem
TYPEBOT_ENCRYPTION_SECRET=coloque-32-caracteres-aleatorios

# Login no painel do Typebot (link mágico por e-mail)
TYPEBOT_ADMIN_EMAIL=voce@seudominio.com.br
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USUARIO=voce@seudominio.com.br
SMTP_SENHA=senha-do-email
SMTP_REMETENTE=pHarmaOnline <voce@seudominio.com.br>
